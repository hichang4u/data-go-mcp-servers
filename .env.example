# 루트 .env — 서버(load_dotenv)와 실호출 테스트(tests/conftest.py)가 읽는다. 커밋되지 않는다.
# MCP 클라이언트로 쓸 때는 이 파일 대신 클라이언트 설정의 "env" 로 넘긴다 (docs/guide/installation.md).
# 키 발급·활용신청: docs/guide/api-keys.md

# ── data.go.kr 인증키 ─────────────────────────────────────────────────────────
# 발급: https://www.data.go.kr → 마이페이지 → 일반 인증키 (Decoding). 보통 "==" 로 끝난다.
# Encoding 값(%2B, %3D 가 섞인 것)을 넣으면 코드 30 (등록되지 않은 서비스키) 이 난다.
# 키 하나로 6개 서버(nps, nts, pps, fsc, presidential, msds)를 전부 호출한다.
# 단, API 마다 활용신청이 따로 필요하다 (자동승인). 미신청 시 코드 30 또는 HTTP 401.
API_KEY=

# 서버별로 다른 data.go.kr 계정의 키를 쓰고 싶을 때만. 없으면 API_KEY 를 쓴다.
# NPS_BUSINESS_ENROLLMENT_API_KEY=
# NTS_BUSINESS_VERIFICATION_API_KEY=
# PPS_NARAJANGTEO_API_KEY=
# FSC_FINANCIAL_INFO_API_KEY=
# PRESIDENTIAL_SPEECHES_API_KEY=
# MSDS_CHEMICAL_INFO_API_KEY=

# 국토부 실거래가(molit-realestate)는 공통 API_KEY 를 쓰되 부동산 종류마다 활용신청이 필요하다.

# ── OpenDART 인증키 (dart-disclosure 전용) ────────────────────────────────────
# 금융감독원 전자공시는 data.go.kr 과 무관하다. API_KEY 로는 호출되지 않는다 (코드 010).
# 발급: https://opendart.fss.or.kr → 인증키 신청/관리 → 인증키 신청 (즉시, 40자 hex, 일 20,000건).
# 비어 있으면 dart-disclosure 툴만 실패하고, 실호출 테스트에서 그 항목만 skip 된다.
DART_DISCLOSURE_API_KEY=

# ── 한국은행 ECOS 인증키 (bok-ecos 전용) ──────────────────────────────────────
# 발급: https://ecos.bok.or.kr → 오픈API → 인증키 신청 (즉시).
# sample 을 넣으면 한 번에 10건까지 시험해 볼 수 있다.
# 비어 있으면 bok-ecos 툴만 실패하고, 실호출 테스트에서 그 항목만 skip 된다.
BOK_ECOS_API_KEY=

# ── 고용24(옛 워크넷) 인증키 ──────────────────────────────────────────────────
# 채용정보·임금체불 명단 등. data.go.kr 의 "워크넷 채용정보"는 등록유형이 LINK 라
# 공통 API_KEY 로는 호출되지 않는다 (엔드포인트가 www.work24.go.kr).
# 발급: https://www.work24.go.kr → 오픈API → 서비스별로 신청 (서비스마다 따로 승인된다).
# 비어 있으면 해당 툴만 실패하고, 실호출 테스트에서 그 항목만 skip 된다.
WORK24_API_KEY=
