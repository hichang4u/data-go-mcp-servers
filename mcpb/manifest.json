{
  "manifest_version": "0.4",
  "name": "data-go-mcp",
  "display_name": "Korea Public Data (data.go.kr + OpenDART)",
  "version": "0.6.2",
  "description": "국세청 사업자등록, 국민연금 사업장, 나라장터 입찰, 금융위 기업재무·주식시세, 대통령 연설문, MSDS, DART 전자공시 — 한국 공공 API 11종을 툴 36개로",
  "long_description": "data.go.kr 공공 API 10종과 OpenDART 를 하나의 MCP 서버로 묶었다. 사업자등록번호 진위·상태 확인, 국민연금 가입 사업장 검색, 나라장터 입찰공고·낙찰·계약 조회, 기업 재무제표·주식시세, 대통령기록관 연설문 검색, 화학물질 MSDS, DART 공시 목록·원문·재무제표. data.go.kr 인증키 하나로 6개 서버를, OpenDART 인증키로 DART 를 쓴다. 서버별로 따로 설치하려면 https://github.com/hichang4u/data-go-mcp-servers 를 본다.",
  "author": {
    "name": "hichang4u",
    "url": "https://github.com/hichang4u"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hichang4u/data-go-mcp-servers"
  },
  "homepage": "https://github.com/hichang4u/data-go-mcp-servers",
  "documentation": "https://github.com/hichang4u/data-go-mcp-servers/blob/main/docs/guide/installation.md",
  "support": "https://github.com/hichang4u/data-go-mcp-servers/issues",
  "server": {
    "type": "python",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/server.py"
      ],
      "env": {
        "API_KEY": "${user_config.api_key}",
        "DART_DISCLOSURE_API_KEY": "${user_config.dart_api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "data.go.kr 인증키",
      "description": "공공데이터포털(https://www.data.go.kr) 마이페이지의 일반 인증키(Decoding). 6개 API 에 각각 활용신청이 필요하다.",
      "sensitive": true,
      "required": true
    },
    "dart_api_key": {
      "type": "string",
      "title": "OpenDART 인증키 (선택)",
      "description": "https://opendart.fss.or.kr 에서 발급. 비우면 DART 공시 툴만 실패한다.",
      "sensitive": true,
      "required": false,
      "default": ""
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "keywords": [
    "korea",
    "data.go.kr",
    "opendart",
    "dart",
    "business-registration",
    "nps",
    "narajangteo",
    "msds",
    "public-data"
  ],
  "license": "Apache-2.0",
  "tools": [
    {
      "name": "batch_validate_businesses",
      "description": "여러 사업자등록정보를 한 번에 진위확인합니다. Batch validate business registrations.",
      "inputSchema": {
        "properties": {
          "businesses_json": {
            "description": "JSON 배열 문자열, 최대 100개. 각 항목 필수: b_no, start_dt, p_nm. 선택: p_nm2, b_nm, corp_no, b_sector, b_type, b_adr. 예: [{\"b_no\": \"1234567890\", \"start_dt\": \"20200101\", \"p_nm\": \"홍길동\"}]",
            "title": "Businesses Json",
            "type": "string"
          }
        },
        "required": [
          "businesses_json"
        ],
        "title": "batch_validate_businessesArguments",
        "type": "object"
      }
    },
    {
      "name": "check_business_status",
      "description": "사업자등록 상태를 조회합니다. Check business registration status.",
      "inputSchema": {
        "properties": {
          "business_numbers": {
            "description": "사업자등록번호 목록, 쉼표 구분, 최대 100개 (하이픈 허용)",
            "title": "Business Numbers",
            "type": "string"
          }
        },
        "required": [
          "business_numbers"
        ],
        "title": "check_business_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "find_corp_code",
      "description": "회사명 또는 종목코드로 DART 고유번호(corp_code)를 찾습니다. 다른 툴의 corp_code 입력에 씁니다. | Find the 8-digit DART corp_code by company name or stock code.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "회사명(한글·영문, 부분 일치) 또는 6자리 종목코드 | Company name (partial) or 6-digit stock code",
            "title": "Query",
            "type": "string"
          },
          "listed_only": {
            "default": false,
            "description": "상장사(종목코드 있는 회사)만 | Only listed companies (default: false)",
            "title": "Listed Only",
            "type": "boolean"
          },
          "limit": {
            "default": 20,
            "description": "최대 결과 수 (기본값: 20)",
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "find_corp_codeArguments",
        "type": "object"
      }
    },
    {
      "name": "find_corp_number",
      "description": "법인명 또는 사업자등록번호로 법인등록번호(crno)를 찾습니다. 다른 재무정보 툴의 crno 입력에 씁니다. | Find the 13-digit corporate registration number (crno) by name or business number.",
      "inputSchema": {
        "properties": {
          "corp_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "법인명 (부분 일치, 예: '삼성전자(주)') | Corporate name (partial match)",
            "title": "Corp Name"
          },
          "bzno": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "사업자등록번호 (10자리, 하이픈 허용) | Business registration number",
            "title": "Bzno"
          },
          "page_no": {
            "default": 1,
            "description": "페이지 번호 (기본값: 1) | Page number (default: 1)",
            "title": "Page No",
            "type": "integer"
          },
          "num_of_rows": {
            "default": 100,
            "description": "한 페이지 조회 레코드 수 (기본값: 100, 최대: 100) | Records per page",
            "title": "Num Of Rows",
            "type": "integer"
          }
        },
        "title": "find_corp_numberArguments",
        "type": "object"
      }
    },
    {
      "name": "find_region_code",
      "description": "지역명으로 법정동코드를 찾습니다.",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "지역명 (부분 일치, 예: '강남구', '서울특별시 강남구 역삼동', '가평읍')",
            "title": "Name",
            "type": "string"
          },
          "page_no": {
            "default": 1,
            "description": "페이지 번호 (기본값: 1)",
            "title": "Page No",
            "type": "integer"
          },
          "num_of_rows": {
            "default": 100,
            "description": "한 페이지 결과 수 (기본값: 100)",
            "title": "Num Of Rows",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "find_region_codeArguments",
        "type": "object"
      }
    },
    {
      "name": "get_balance_sheet",
      "description": "기업의 재무상태표(대차대조표)를 조회합니다. 자산, 부채, 자본의 세부 계정과목별 금액을 확인할 수 있습니다. | Get balance sheet with detailed account items for assets, liabilities, and equity.",
      "inputSchema": {
        "properties": {
          "crno": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "법인등록번호 (13자리 숫자, 하이픈 제외; 모르면 find_corp_number 로 조회) | Corporate registration number (13 digits)",
            "title": "Crno"
          },
          "biz_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "사업연도 (예: 2023) | Business year (e.g., 2023)",
            "title": "Biz Year"
          },
          "page_no": {
            "default": 1,
            "description": "페이지 번호 (기본값: 1) | Page number (default: 1)",
            "title": "Page No",
            "type": "integer"
          },
          "num_of_rows": {
            "default": 10,
            "description": "한 페이지 결과 수 (기본값: 10, 최대: 100) | Number of rows per page (default: 10, max: 100)",
            "title": "Num Of Rows",
            "type": "integer"
          }
        },
        "title": "get_balance_sheetArguments",
        "type": "object"
      }
    },
    {
      "name": "get_bid_detail",
      "description": "특정 입찰공고의 상세정보를 조회합니다. Get one bid announcement by its notice number.",
      "inputSchema": {
        "properties": {
          "bid_notice_no": {
            "description": "입찰공고번호 (예: R25BK00933743)",
            "title": "Bid Notice No",
            "type": "string"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "날짜 (YYYY-MM-DD 또는 YYYYMMDD)",
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "날짜 (YYYY-MM-DD 또는 YYYYMMDD)",
            "title": "End Date"
          }
        },
        "required": [
          "bid_notice_no"
        ],
        "title": "get_bid_detailArguments",
        "type": "object"
      }
    },
    {
      "name": "get_business_detail",
      "description": "사업장 상세정보를 조회합니다.",
      "inputSchema": {
        "properties": {
          "seq": {
            "description": "사업장 식별번호 (search_business 결과의 seq)",
            "title": "Seq",
            "type": "integer"
          },
          "page_no": {
            "default": 1,
            "description": "페이지 번호 (기본값: 1)",
            "title": "Page No",
            "type": "integer"
          },
          "num_of_rows": {
            "default": 10,
            "description": "한 페이지 결과 수 (기본값: 10)",
            "title": "Num Of Rows",
            "type": "integer"
          }
        },
        "required": [
          "seq"
        ],
        "title": "get_business_detailArguments",
        "type": "object"
      }
    },
    {
      "name": "get_chemical_handling_info",
      "description": "화학물질의 취급·보호 정보를 조회합니다 (섹션 5-8: 화재, 누출, 취급·저장, 보호구).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          }
        },
        "required": [
          "chem_id"
        ],
        "title": "get_chemical_handling_infoArguments",
        "type": "object"
      }
    },
    {
      "name": "get_chemical_properties",
      "description": "화학물질의 물성·독성 정보를 조회합니다 (섹션 9-12: 물리화학적 특성, 안정성, 독성, 환경).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          }
        },
        "required": [
          "chem_id"
        ],
        "title": "get_chemical_propertiesArguments",
        "type": "object"
      }
    },
    {
      "name": "get_chemical_regulatory_info",
      "description": "화학물질의 규제·폐기 정보를 조회합니다 (섹션 13-16: 폐기, 운송, 법적 규제, 기타).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          }
        },
        "required": [
          "chem_id"
        ],
        "title": "get_chemical_regulatory_infoArguments",
        "type": "object"
      }
    },
    {
      "name": "get_chemical_safety_summary",
      "description": "화학물질의 핵심 안전정보를 조회합니다 (섹션 1-4: 제품·회사, 유해성, 구성성분, 응급조치).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          }
        },
        "required": [
          "chem_id"
        ],
        "title": "get_chemical_safety_summaryArguments",
        "type": "object"
      }
    },
    {
      "name": "get_chemical_section",
      "description": "화학물질 MSDS 의 특정 섹션을 조회합니다. Get one MSDS section (1-16).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          },
          "section_number": {
            "description": "섹션 번호 1-16:\n1: 화학제품과 회사에 관한 정보\n2: 유해성·위험성\n3: 구성성분의 명칭 및 함유량\n4: 응급조치요령\n5: 폭발·화재시 대처방법\n6: 누출사고시 대처방법\n7: 취급 및 저장방법\n8: 노출방지 및 개인보호구\n9: 물리화학적 특성\n10: 안정성 및 반응성\n11: 독성에 관한 정보\n12: 환경에 미치는 영향\n13: 폐기시 주의사항\n14: 운송에 필요한 정보\n15: 법적 규제현황\n16: 그 밖의 참고사항",
            "title": "Section Number",
            "type": "integer"
          }
        },
        "required": [
          "chem_id",
          "section_number"
        ],
        "title": "get_chemical_sectionArguments",
        "type": "object"
      }
    },
    {
      "name": "get_company",
      "description": "DART 고유번호로 기업 개황(정식명칭, 대표자, 법인등록번호, 사업자등록번호, 주소, 설립일, 결산월 등)을 조회합니다. | Get a company profile by corp_code.",
      "inputSchema": {
        "properties": {
          "corp_code": {
            "description": "DART 고유번호 (8자리 숫자; 모르면 find_corp_code 로 조회) | DART corp_code (8 digits)",
            "title": "Corp Code",
            "type": "string"
          }
        },
        "required": [
          "corp_code"
        ],
        "title": "get_companyArguments",
        "type": "object"
      }
    },
    {
      "name": "get_complete_msds",
      "description": "화학물질의 전체 MSDS (16개 섹션)를 조회합니다. Get the complete MSDS (all 16 sections).",
      "inputSchema": {
        "properties": {
          "chem_id": {
            "description": "화학물질ID 6자리 (search_chemicals 결과의 chem_id; 짧으면 0으로 채움)",
            "title": "Chem Id",
            "type": "string"
          }
        },
        "required": [
          "chem_id"
        ],
        "title": "get_complete_msdsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_corp_outline",
      "description": "법인등록번호로 기업 개요를 조회합니다: 대표자, 주소, 상장시장, 설립일, 종업원 수, 평균 급여, 감사인·감사의견 등. | Get the corporate profile (representative, address, market, employees, average salary, auditor) by crno.",
      "inputSchema": {
        "properties": {
          "crno": {
            "description": "법인등록번호 (13자리 숫자, 하이픈 제외; 모르면 find_corp_number 로 조회) | Corporate registration number (13 digits)",
            "title": "Crno",
            "type": "string"
          }
        },
        "required": [
          "crno"
        ],
        "title": "get_corp_outlineArguments",
        "type": "object"
      }
    },
    {
      "name": "get_disclosure_document",
      "description": "공시 원문을 텍스트로 조회합니다. 사업보고서는 수십만 자라 offset/max_chars 로 나눠 읽습니다. | Get the full text of a disclosure document, paged by offset/max_chars.",
      "inputSchema": {
        "properties": {
          "rcept_no": {
            "description": "접수번호 (14자리; list_disclosures 의 rcept_no) | Receipt number",
            "title": "Rcept No",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "description": "본문 시작 문자 위치 (기본값: 0)",
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "max_chars": {
            "default": 20000,
            "description": "돌려줄 최대 문자 수 (기본값: 20000)",
            "maximum": 200000,
            "minimum": 1,
            "title": "Max Chars",
            "type": "integer"
          }
        },
        "required": [
          "rcept_no"
        ],
        "title": "get_disclosure_documentArguments",
        "type": "object"
      }
    },
    {
      "name": "get_financial_statements",
      "description": "정기보고서의 전체 재무제표를 XBRL 계정 단위로 조회합니다 (재무상태표·손익계산서·포괄손익계산서·현금흐름표·자본변동표). | Get full financial statements (all XBRL account lines).",
      "inputSchema": {
        "properties": {
          "corp_code": {
            "description": "DART 고유번호 (8자리 숫자; 모르면 find_corp_code 로 조회) | DART corp_code (8 digits)",
            "title": "Corp Code",
            "type": "string"
          },
          "bsns_year": {
            "description": "사업연도 YYYY (예: 2024). 2015년 이후만 제공 | Business year",
            "title": "Bsns Year",
            "type": "string"
          },
          "reprt_code": {
            "default": "11011",
            "description": "보고서 코드: 11011 사업보고서(기본), 11012 반기보고서, 11013 1분기보고서, 11014 3분기보고서 | Report type",
